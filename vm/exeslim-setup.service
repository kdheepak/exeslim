[Unit]
Description=Apply the GitHub integration marked exeslim-setup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=exedev
Group=exedev
WorkingDirectory=/home/exedev
Environment=HOME=/home/exedev
Environment=USER=exedev
Environment=PATH=/home/exedev/.local/share/mise/shims:/home/exedev/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/libexec/exeslim-setup
TimeoutStartSec=45min
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exeslim-setup
